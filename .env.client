# Client configuration — bundled into the app binary.
#
# NOTHING SECRET GOES IN THIS FILE. Flutter packages it as an asset, so anyone
# who downloads the APK can read it. Server secrets (MONGO_URI, JWT_SECRET) live
# in `.env`, which the Node server reads and the client never sees.
#
# Android emulator reaches the host machine at 10.0.2.2.
# iOS simulator and web builds use localhost.
# A physical device needs your machine's LAN IP, e.g. http://192.168.1.7:5000/api
API_BASE_URL=http://10.0.2.2:5000/api
