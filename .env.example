# Unified local configuration. Copy to `.env` and fill in the values you use.
# Flutter also loads this file, so do not use this arrangement for a production
# build: anything bundled with Flutter can be read by the app user.

# Client configuration
API_BASE_URL=http://10.0.2.2:5000/api
# Public Google Maps key, only needed by map integrations that use Google Maps.
GOOGLE_MAPS_API_KEY=

# Server configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/civic_connect

# Sign your own. `openssl rand -base64 32` produces a good one.
# The server warns loudly at boot if this is left as a known placeholder.
JWT_SECRET=

# Public base URL the server uses to build photograph links.
API_URL=http://localhost:5000

# Comma-separated Google OAuth client IDs. Until set, POST /api/auth/google
# refuses every request rather than trusting the token it was handed.
GOOGLE_CLIENT_IDS=

# Comma-separated web origins allowed to call the API. Unset allows every
# origin, which is fine locally and wrong in production.
CORS_ORIGINS=

# Optional AI service used by the clustering pipeline.
AI_SERVICE_URL=http://localhost:8000
